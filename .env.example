# GEMINI_API_KEY: required. One key powers everything (photo analysis, SVG drawing, image painting).
# Get one free at https://aistudio.google.com/apikey  ->  copy this file to .env
#   or run: ./scripts/set-api-key.sh   (hidden input, writes .env)
GEMINI_API_KEY=""

# Model cascade (cheapest first; escalates only when output fails validation). Optional overrides:
# GEMINI_SMALL_MODEL=                             # analysis / JSON
# GEMINI_MEDIUM_MODEL=                             # first SVG attempt, analysis fallback
# GEMINI_LARGE_MODEL=                             # last-resort SVG escalation
# GEMINI_IMAGE_MODEL=                        # force a specific image-painting model
# STICKER_DRAW_WITH_PHOTO=1                  # also send the photo on SVG draw calls (more tokens)
# PORT=3000
