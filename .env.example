# ANTHROPIC_API_KEY: required. Claude analyses each photo and draws the stickers.
# Get one at https://platform.claude.com/ -> API keys. Copy this file to .env.
ANTHROPIC_API_KEY=""

# Optional overrides
# STICKER_MODEL="claude-opus-5-5"   # model used for analysis + drawing
# STICKER_EFFORT="medium"           # low = faster/cheaper, high = more detailed art
# PORT=3000

# GEMINI_API_KEY: optional. Gemini paints the stickers (Claude still plans them). ./scripts/set-api-key.sh GEMINI_API_KEY
GEMINI_API_KEY=""
# GEMINI_IMAGE_MODEL="gemini-3-pro-image"   # default picks the newest Flash image model (cheaper); Pro = highest quality
